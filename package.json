{
  "name": "cuentas-claras",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/node-spawn-compat.cjs ./node_modules/vite/bin/vite.js --configLoader native",
    "build": "tsc -b && node --require ./scripts/node-spawn-compat.cjs ./node_modules/vite/bin/vite.js build --configLoader native",
    "preview": "node --require ./scripts/node-spawn-compat.cjs ./node_modules/vite/bin/vite.js preview",
    "test": "node --require ./scripts/node-spawn-compat.cjs ./node_modules/vitest/vitest.mjs run --configLoader native --pool=threads"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.10"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vitest": "^3.2.4"
  }
}
